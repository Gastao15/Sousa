# SG NutriMZ — Phase 1A environment variables
#
# Phase 1A runs entirely client-side with localStorage and ships with no
# external services, analytics, or payment integrations. This file is kept
# as a placeholder for future phases (see PRODUCT_ROADMAP.md) and documents
# the variables a future build may expect. No real secrets should ever be
# committed to this repository.

# Public app metadata (safe to expose to the browser)
NEXT_PUBLIC_APP_NAME="SG NutriMZ"
NEXT_PUBLIC_APP_ENV="development"

# Placeholder for a future verified nutrition database API (Phase 2+).
# Leave empty in Phase 1A — no external API calls are made.
# NEXT_PUBLIC_NUTRITION_API_BASE_URL=

# Placeholder for future payment integrations (Phase 3+: M-Pesa, e-Mola,
# mKesh, Stripe). Phase 1A uses a mock paywall only and never calls these.
# PAYMENTS_PROVIDER_API_KEY=
